<Window x:Class="UsbIpClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UsbIpClient"
        Title="USB/IP"
        Icon="app.ico"
        Width="600" Height="680" MinWidth="440" MinHeight="380"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="USB/IP" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Use USB devices from other computers and phones as if they were plugged in here, or share this PC's devices with them."
                       Style="{StaticResource Secondary}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- First-run setup -->
        <Border Grid.Row="1" Style="{StaticResource Card}"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                Visibility="{Binding SetupNeeded, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Install" MinWidth="96" Click="Install_Click" VerticalAlignment="Center"
                        Margin="12,0,0,0" IsEnabled="{Binding CanInstall}" Style="{DynamicResource AccentButtonStyle}" />
                <StackPanel>
                    <TextBlock Text="Finish setting up" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,6"
                               Text="USB/IP uses two signed open-source drivers. Installing them needs one administrator approval." />
                    <TextBlock Text="{Binding ClientComponentText}" Style="{StaticResource Secondary}" />
                    <TextBlock Text="{Binding ServerComponentText}" Style="{StaticResource Secondary}" />
                    <TextBlock Text="{Binding SetupText}" Margin="0,6,0,0" FontWeight="SemiBold"
                               Visibility="{Binding SetupText, Converter={x:Static local:Converters.NonEmptyToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="2" Grid.RowSpan="2" Margin="0,0,0,10">
            <TabItem Header="Use remote devices">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Servers -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="-4,0,-4,0" Padding="4,0,4,0">
                        <StackPanel>
                            <Border Style="{StaticResource Card}"
                                    Visibility="{Binding HasServers, Converter={x:Static local:Converters.InverseBoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Looking for servers…" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0"
                                               Text="Open USB/IP Server on your phone and switch on the server. Phones on the same network appear here automatically. Otherwise, add one by address below." />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Servers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ServerVm}">
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <DockPanel LastChildFill="True">
                                                    <Button DockPanel.Dock="Right" Content="Remove" Padding="10,3"
                                                            Click="RemoveServer_Click" VerticalAlignment="Center"
                                                            Visibility="{Binding IsManual, Converter={StaticResource BoolToVis}}" />
                                                    <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,10,0"
                                                             VerticalAlignment="Center" Fill="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource Secondary}">
                                                            <Run Text="{Binding Endpoint, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Status, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>

                                                <TextBlock Text="{Binding EmptyText}" Margin="20,10,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Online}" Value="True" />
                                                                        <Condition Binding="{Binding Devices.Count}" Value="0" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <ItemsControl ItemsSource="{Binding Devices}" Margin="20,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type local:DeviceVm}">
                                                            <Grid Margin="0,8,0,0" Background="Transparent">
                                                                <Grid.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="Rename…" Click="RenameRemote_Click" />
                                                                    </ContextMenu>
                                                                </Grid.ContextMenu>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="Right-click to rename" />
                                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" FontSize="12" />
                                                                    <TextBlock x:Name="State" Text="{Binding StatusText}" FontSize="12" Margin="0,2,0,0"
                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                </StackPanel>
                                                                <CheckBox Grid.Column="1" Content="Auto" IsChecked="{Binding AutoAttach}"
                                                                          VerticalAlignment="Center" Margin="12,0,8,0" MinWidth="0"
                                                                          ToolTip="Attach automatically whenever this device is available" />
                                                                <Button x:Name="Action" Grid.Column="2" Content="{Binding ActionText}" MinWidth="88"
                                                                        IsEnabled="{Binding CanAct}" Click="Toggle_Click" VerticalAlignment="Center" />
                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Attached">
                                                                    <Setter TargetName="State" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="InUseElsewhere">
                                                                    <Setter TargetName="State" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Available">
                                                                    <Setter TargetName="Action" Property="Style" Value="{DynamicResource AccentButtonStyle}" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Online}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Add server -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AddressBox" Grid.Column="0" KeyDown="AddressBox_KeyDown" VerticalContentAlignment="Center" />
                        <TextBlock Grid.Column="0" Text="Add a server by address, e.g. 192.168.1.50 or phone.tailnet.ts.net"
                                   IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding Text.IsEmpty, ElementName=AddressBox, Converter={StaticResource BoolToVis}}" />
                        <Button Grid.Column="1" Content="Add" MinWidth="72" Margin="8,0,0,0" Click="Add_Click" />
                    </Grid>

                </Grid>
            </TabItem>

            <TabItem x:Name="ShareTab" Header="Share this PC">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding ShareStatus}" Style="{StaticResource Secondary}" Margin="0,0,0,10" />

                    <!-- Who can connect (firewall) -->
                    <Expander Grid.Row="1" Margin="0,0,0,12" IsExpanded="{Binding AccessMismatch, Mode=OneWay}"
                              Visibility="{Binding ServerInstalled, Converter={StaticResource BoolToVis}}">
                        <Expander.Header>
                            <StackPanel>
                                <TextBlock Text="Who can connect" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding AccessCurrent}" Style="{StaticResource Secondary}" FontSize="12" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="4,4,4,8">
                            <TextBlock Text="The firewall rule no longer matches your choice (an update may have reset it). Apply it again."
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding AccessMismatch, Converter={StaticResource BoolToVis}}" />
                            <RadioButton GroupName="Access" Margin="0,8,0,0" IsChecked="{Binding AccessLocal}"
                                         Content="This PC's network only" />
                            <RadioButton GroupName="Access" IsChecked="{Binding AccessCustomMode}"
                                         Content="Specific networks and addresses" />
                            <TextBox Text="{Binding AccessCustom, UpdateSourceTrigger=PropertyChanged}" Margin="28,2,0,4"
                                     IsEnabled="{Binding AccessCustomMode}"
                                     ToolTip="Comma-separated IPs, networks (10.0.20.0/24) or ranges (10.0.20.10-10.0.20.50). Add LocalSubnet to keep this PC's network." />
                            <TextBlock Margin="28,0,0,4" FontSize="12" Style="{StaticResource Secondary}"
                                       Text="e.g. LocalSubnet, 10.0.20.0/24, 100.64.0.0/10 (Tailscale)" />
                            <RadioButton GroupName="Access" IsChecked="{Binding AccessAnyone}"
                                         Content="Anyone who can reach this PC" />
                            <TextBlock Margin="0,6,0,0" FontSize="12" Style="{StaticResource Secondary}"
                                       Text="USB/IP has no password or encryption: allow only networks you trust." />
                            <Button Content="Apply" MinWidth="88" Click="ApplyAccess_Click" HorizontalAlignment="Right" Margin="0,8,0,0"
                                    Style="{DynamicResource AccentButtonStyle}"
                                    IsEnabled="{Binding AccessBusy, Converter={x:Static local:Converters.Not}}" />
                        </StackPanel>
                    </Expander>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="-4,0,-4,0" Padding="4,0,4,0">
                        <StackPanel>
                            <Border Style="{StaticResource Card}"
                                    Visibility="{Binding ServerInstalled, Converter={x:Static local:Converters.InverseBoolToVisibility}}">
                                <TextBlock Style="{StaticResource Secondary}"
                                           Text="Sharing needs the usbipd-win service. Use Install above to add it." />
                            </Border>
                            <Border Style="{StaticResource Card}"
                                    Visibility="{Binding ServerInstalled, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding LocalDevices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:LocalDeviceVm}">
                                            <Grid Margin="0,6,0,6" Background="Transparent">
                                                <Grid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Rename…" Click="RenameLocal_Click" />
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="Right-click to rename" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" FontSize="12" />
                                                    <TextBlock x:Name="State" Text="{Binding StatusText}" FontSize="12" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Button x:Name="Action" Grid.Column="1" Content="{Binding ActionText}" MinWidth="110"
                                                        IsEnabled="{Binding CanAct}" Click="ToggleShare_Click" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Shared}" Value="True">
                                                    <Setter TargetName="State" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Attached}" Value="True">
                                                    <Setter TargetName="State" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <DockPanel Grid.Row="4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding DriverVersion, Mode=OneWay}" Style="{StaticResource Secondary}"
                       VerticalAlignment="Center" FontSize="12" Margin="12,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Logs" Click="OpenLogs_Click" Padding="10,2" Margin="12,0,0,0"
                    ToolTip="Open the folder with this app's logs and the sharing service's events" />
            <CheckBox x:Name="StartupBox" DockPanel.Dock="Left" Content="Start with Windows" VerticalAlignment="Center"
                      Checked="Startup_Changed" Unchecked="Startup_Changed" Margin="0,0,16,0" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Secondary}" FontSize="12"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       ToolTip="{Binding StatusText}" />
        </DockPanel>
    </Grid>
</Window>
